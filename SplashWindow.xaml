<Window x:Class="CodeCraftOptimizer.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciando CodeCraft Optimizer" 
        Height="300" Width="450"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <!-- Animación de Pulso para el Logo -->
        <Storyboard x:Key="PulseLogo">
            <DoubleAnimation Storyboard.TargetName="LogoImg"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="1.0" Duration="0:0:1.2"
                             AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.95" To="1.0" Duration="0:0:1.2"
                             AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.95" To="1.0" Duration="0:0:1.2"
                             AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PulseLogo}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="#FF0F172A" CornerRadius="15" BorderBrush="#FF1E293B" BorderThickness="1">
        <Grid>
            <!-- Brillo de fondo -->
            <Ellipse Fill="#2006B6D4" Width="200" Height="200" Margin="0,-100,0,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo -->
                <Image x:Name="LogoImg" Source="/Assets/Logo_CCOptimizer.png" Width="120" Height="120">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" CenterX="60" CenterY="60"/>
                    </Image.RenderTransform>
                </Image>

                <TextBlock Text="CODECRAFT OPTIMIZER" 
                           Foreground="White" FontSize="18" FontWeight="Black" 
                           Margin="0,20,0,5"
                           HorizontalAlignment="Center"/>
                
                <TextBlock Text="PREPARANDO MOTORES DE SISTEMA..." 
                           Foreground="#FF8A92A6" FontSize="10" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Barra de Carga -->
                <Grid Width="300" Height="4">
                    <Border Background="#FF1E293B" CornerRadius="2"/>
                    <Border x:Name="ProgressBar" Background="#FF06B6D4" CornerRadius="2" HorizontalAlignment="Left" Width="0">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF06B6D4" BlurRadius="10" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                </Grid>
            </StackPanel>

            <TextBlock Text="v1.0.0 | © 2026 CodeCraftSW" 
                       Foreground="#40FFFFFF" FontSize="9" 
                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        </Grid>
    </Border>
</Window>
